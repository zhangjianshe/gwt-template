<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:software="urn:import:cn.mapway.gwt_template.client.software"
             xmlns:buttons="urn:import:cn.mapway.ui.client.widget.buttons">

    <g:DockLayoutPanel>
        <g:west size="350">
            <g:ScrollPanel addStyleNames="ai-border-right">
                <software:SoftwareTree ui:field="tree" width="100%"/>
            </g:ScrollPanel>
        </g:west>
        <g:north size="0">
            <g:HorizontalPanel ui:field="tools" spacing="4" verticalAlignment="middle">
                <buttons:AiButton ui:field="btnEdit" enabled="false">修改软件</buttons:AiButton>
                <buttons:AiButton ui:field="btnCreate">创建软件</buttons:AiButton>
            </g:HorizontalPanel>
        </g:north>
        <g:center>
            <software:SoftwareList ui:field="softwarePanel"/>
        </g:center>
    </g:DockLayoutPanel>
</ui:UiBinder>