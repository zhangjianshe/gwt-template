<ui:UiBinder xmlns:ui='urn:ui:com.google.gwt.uibinder'
             xmlns:g='urn:import:com.google.gwt.user.client.ui'
             xmlns:dialog="urn:import:cn.mapway.ui.client.widget.dialog"
             xmlns:widget="urn:import:cn.mapway.gwt_template.client.widget">
    <ui:style>
        .box {
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 1rem;
            margin: 10px 0;
        }

        .left {
            width: 130px;
            font-weight: bold;
        }

        .box0 {
            padding: 10px;
        }

        .fileName {
            color: #666;
        }

        .uploader {
            opacity: 0;
            cursor: pointer;
        }
    </ui:style>
    <g:DockLayoutPanel>
        <g:south size="68">
            <dialog:SaveBar ui:field="saveBar"/>
        </g:south>
        <g:center>
            <g:HTMLPanel addStyleNames="{style.box0}">
                <g:HTMLPanel addStyleNames="{style.box}">
                    <g:Label addStyleNames="{style.left}">软件</g:Label>
                    <g:Label ui:field="lbSoftware"/>
                </g:HTMLPanel>
                <g:HTMLPanel addStyleNames="{style.box}">
                    <g:Label addStyleNames="{style.left}">版本</g:Label>
                    <widget:TextBox ui:field="txtVersion"/>
                </g:HTMLPanel>
                <g:HTMLPanel addStyleNames="{style.box}">
                    <g:Label addStyleNames="{style.left}">架构</g:Label>
                    <g:ListBox ui:field="lstArch" addStyleNames="ai-input"/>
                </g:HTMLPanel>
                <g:HTMLPanel addStyleNames="{style.box}">
                    <g:Label addStyleNames="{style.left}">操作系统</g:Label>
                    <g:ListBox ui:field="lstOs" addStyleNames="ai-input"/>
                </g:HTMLPanel>
                <g:HTMLPanel addStyleNames="{style.box}">
                    <g:Label addStyleNames="{style.left}">文件</g:Label>
                    <g:HorizontalPanel verticalAlignment="middle" spacing="8">
                        <g:LayoutPanel width="100px" height="32px">
                            <g:layer>
                                <g:Button ui:field="btnPickFile" width="100px">选择文件</g:Button>
                            </g:layer>
                            <g:layer>
                                <g:FileUpload ui:field="fileUpload" addStyleNames="{style.uploader}"/>
                            </g:layer>
                        </g:LayoutPanel>
                        <g:Label ui:field="lbFileName" addStyleNames="{style.fileName}"/>
                    </g:HorizontalPanel>
                </g:HTMLPanel>
            </g:HTMLPanel>
        </g:center>
    </g:DockLayoutPanel>
</ui:UiBinder>
